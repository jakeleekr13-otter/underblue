    "Add photos, videos or whole folders: drag them into the window or press ⌘O. You can also use Share in Finder or Photos." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add photos, videos or whole folders: drag them into the window or press ⌘O. You can also use Share in Finder or Photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真、ビデオ、フォルダごと追加します。ウインドウにドラッグするか、⌘Oを押してください。Finderや写真アプリの共有機能も使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진, 동영상 또는 폴더 전체를 추가하세요. 창으로 끌어다 놓거나 ⌘O를 누르면 됩니다. Finder나 사진 앱의 공유 메뉴도 사용할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加照片、视频或整个文件夹：拖入窗口，或按 ⌘O。也可以使用访达或“照片”中的共享功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入照片、影片或整個資料夾：拖到視窗中，或按 ⌘O。也可以使用 Finder 或「照片」中的分享功能。"
          }
        }
      }
    },
